{
  "name": "paidmcp-client",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Local stdio proxy for paid MCP servers with x402 handling.",
  "license": "MIT",
  "author": "PaidMCP",
  "homepage": "https://paidmcp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paidmcp/client.git"
  },
  "bugs": {
    "url": "https://github.com/paidmcp/client/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "ai-agents",
    "payments",
    "usdc",
    "usdt",
    "stablecoin"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "paidmcp": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "start": "node dist/cli.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "check": "npm run lint && npm run typecheck && npm run build",
    "init": "node dist/cli.js init",
    "wallet": "node dist/cli.js wallet",
    "wallet:import": "node dist/cli.js wallet:import",
    "doctor": "node dist/cli.js doctor",
    "connect": "node dist/cli.js connect",
    "run": "node dist/cli.js run",
    "test:paid-fetch": "node scripts/tests/paid-fetch.smoke.mjs http://localhost:4021",
    "debug:x402-base": "node scripts/debug/x402-base-flow.debug.mjs",
    "debug:x402-plasma": "node scripts/debug/x402-plasma-flow.debug.mjs",
    "debug:plasma-facilitators": "node scripts/debug/plasma-facilitator-compare.debug.mjs",
    "debug:facilitator-matrix": "node scripts/debug/facilitator-matrix.debug.mjs",
    "debug:settle-resource-url": "node scripts/debug/settle-resource-url.debug.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.12",
    "@x402/evm": "^2.13.0",
    "@x402/fetch": "^2.13.0",
    "bip39": "^3.1.0",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.46.4",
    "typescript": "^6.0.3"
  }
}
